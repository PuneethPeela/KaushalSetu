# KaushalSetu Environment Configuration

# Optional: SerpApi key for Google Trends API
# Without this, pytrends or zero bonus fallback is used automatically
SERPAPI_KEY=

# Optional: Google Gemini API key (Free Tier - gemini-2.5-flash / gemini-1.5-flash)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Neon Serverless Postgres connection string
# Example: postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If empty, pipeline outputs to outputs/*.csv and uses local caching
DATABASE_URL=

# Port for FastAPI server (Render sets PORT automatically)
PORT=8000
